# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated chat IDs the bot will respond to.
# Group chat IDs are negative numbers (e.g. -1001234567890).
# User DM IDs are positive numbers.
# Leave empty to allow ALL chats (NOT recommended).
ALLOWED_CHAT_IDS=

# Optional: secret token Telegram includes in webhook header.
# Set this when registering the webhook with ?secret_token=...
# Leave empty to skip header verification.
TELEGRAM_WEBHOOK_SECRET=

# Optional: override translation model. Default: claude-sonnet-4-6
# For higher quality use claude-opus-4-7 (~5x cost).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Runway Dev API secret (dev.runway.com) — enables the /image <prompt> command.
RUNWAYML_API_SECRET=
